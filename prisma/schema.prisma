generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cards          Card[]
  rules          Rule[]
  proxyCard      ProxyCard?
  transactions   Transaction[]
  auditLogs      AuditLog[]
  sessions       Session[]
  idempotencyKeys IdempotencyKey[]
  decisions      Decision[]
  defaultCardId  String?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipHash    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Card {
  id             String   @id @default(cuid())
  userId         String
  nickname       String
  brand          String
  last4          String
  tokenCipher    String
  tokenIv        String
  tokenTag       String
  expiryMonth    Int
  expiryYear     Int
  color          String   @default("#0f766e")
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  creditLimit    Float?
  currentBalance Float    @default(0)
  networkHint    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewards          RewardRate[]
  transactions     Transaction[]
  decisions        Decision[]
  forcedByRules    Rule[]        @relation("ForceCard")
  preferredByRules Rule[]        @relation("PreferCard")
  excludedByRules  Rule[]        @relation("ExcludeCard")

  @@index([userId])
  @@index([userId, isActive])
}

model RewardRate {
  id         String    @id @default(cuid())
  cardId     String
  category   String
  multiplier Float     @default(1)
  capCents   Int?
  isRotating Boolean   @default(false)
  validFrom  DateTime?
  validTo    DateTime?
  note       String?

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, category])
  @@index([cardId])
}

model Rule {
  id            String   @id @default(cuid())
  userId        String
  name          String
  description   String?
  enabled       Boolean  @default(true)
  priority      Int      @default(100)
  action        String
  conditions    String   @default("{}")
  forceCardId   String?
  preferCardId  String?
  excludeCardId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  forceCard   Card? @relation("ForceCard", fields: [forceCardId], references: [id], onDelete: SetNull)
  preferCard  Card? @relation("PreferCard", fields: [preferCardId], references: [id], onDelete: SetNull)
  excludeCard Card? @relation("ExcludeCard", fields: [excludeCardId], references: [id], onDelete: SetNull)

  @@index([userId, enabled, priority])
}

model ProxyCard {
  id               String   @id @default(cuid())
  userId           String   @unique
  label            String   @default("Routely Proxy")
  virtualLast4     String
  virtualPrefix    String   @default("4000 00")
  status           String   @default("active")
  credentialCipher String
  credentialIv     String
  credentialTag    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id             String    @id @default(cuid())
  userId         String
  cardId         String?
  amountCents    Int
  currency       String    @default("USD")
  merchant       String
  category       String
  mcc            String?
  isOnline       Boolean   @default(true)
  status         String    @default("authorized")
  routingReason  String
  routingDetail  String    @default("{}")
  rewardsEarned  Float     @default(0)
  multiplierUsed Float     @default(1)
  declinedReason String?
  proxyUsed      Boolean   @default(true)
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([cardId])
  @@index([userId, cardId, category, createdAt])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  key          String
  requestHash  String
  responseJson String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  meta       String   @default("{}")
  ipHash     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
}

model Decision {
  id               String   @id @default(cuid())
  userId           String
  merchant         String
  category         String
  amountCents      Int?
  isOnline         Boolean  @default(false)
  cardId           String?
  cardNickname     String?
  cardLast4        String?
  cardBrand        String?
  cardColor        String?
  multiplierUsed   Float    @default(1)
  rewardsEstimated Float    @default(0)
  routingReason    String
  routingDetail    String   @default("{}")
  createdAt        DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, merchant])
}
